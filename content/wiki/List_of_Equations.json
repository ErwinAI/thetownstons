  "html": "<p>Eventually will have a complete list of equations for reference.\n--<a href=\"/wiki/User:Spetsdod\" title=\"User:Spetsdod\">Spetsdod</a> 08:41, 14 February 2008 (CET)\n</p>\n<table align=\"center\" border=\"1\" cellpadding=\"12\" cellspacing=\"0\" style=\"text-align:center;\">\n<tr>\n<th><big>Equation Name</big>\n</th><th><big>Equation</big>\n</th></tr>\n<tr>\n<td>Avg DPS<br/><b>Single Weapons</b>\n</td><td><i>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"text-align:left;\">\n<tr>\n<td align=\"right\">Avg DPS = \n</td><td>\n<table>\n<tr>\n<td><u>  min dmg + max dmg  </u>\n</td></tr>\n<tr>\n<td align=\"center\">2 x attack speed\n</td></tr></table>\n</td><td align=\"right\">       <b>[1A]</b>\n</td></tr></table></i>\n</td></tr>\n<tr>\n<td>Avg DPS<br/><b>Dual Wield</b>\n</td><td><i>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"text-align:left;\">\n<tr>\n<td align=\"right\">Avg DPS = \n</td><td>\n<table>\n<tr>\n<td><u>  min dmg 1 + max dmg 1 + min dmg 2 + max dmg 2  </u>\n</td></tr>\n<tr>\n<td align=\"center\">2 x (attack speed 1 + attack speed 2)\n</td></tr></table>\n</td><td align=\"right\">       <b>[1B]</b>\n</td></tr></table></i>\n</td></tr>\n<tr>\n<td>Avg DPS<br/>Base Dmg Bonuses<br/><b>Single Weapons</b>\n</td><td><i>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"text-align:left;\">\n<tr>\n<td align=\"right\">Avg DPS = \n</td><td>\n<table>\n<tr>\n<td style=\"font-size: 250%\" valign=\"center\">(\n</td><td>\n<table>\n<tr>\n<td><u>min dmg + max dmg</u>\n</td></tr>\n<tr>\n<td align=\"center\">2 x Attk Spd\n</td></tr>\n</table>\n</td><td> + Bonus Weap. DPS\n</td><td style=\"font-size: 250%\" valign=\"center\">)\n</td><td> x (1 + % Bonus)\n</td></tr></table>\n</td><td align=\"right\">   <b>[2A]</b>\n</td></tr></table></i>\n</td></tr>\n<tr>\n<td>Avg DPS<br/>Dmg Bonuses<br/><b>Dual Wield</b>\n</td><td><i>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"text-align:left; font-size:80%;\">\n<tr>\n<td align=\"right\" style=\"font-size: 125%\" valign=\"center\"><br/>Avg DPS = \n</td><td>\n<table>\n<tr>\n<td>\n<table>\n<tr>\n<td style=\"font-size: 250%\" valign=\"center\">(\n</td><td>min dmg 1 + max dmg 1 +\n</td><td>\n<table>\n<tr>\n<td><u>Bonus DPS 1</u>\n</td></tr>\n<tr>\n<td align=\"center\">Attk Spd 1\n</td></tr></table>\n</td><td style=\"font-size: 250%\" valign=\"center\">)\n</td><td> x (1 + %Bonus 1) +\n</td><td style=\"font-size: 250%\" valign=\"center\">(\n</td><td>min dmg 2 + max dmg 2 +\n</td><td>\n<table>\n<tr>\n<td><u>Bonus DPS 2</u>\n</td></tr>\n<tr>\n<td align=\"center\">Attk Spd 2\n</td></tr></table>\n</td><td style=\"font-size: 250%\" valign=\"center\">)\n</td><td> x (1 + %Bonus 2)\n</td></tr>\n<tr>\n<td colspan=\"11\">\n<hr/>\n</td></tr>\n<tr>\n<td align=\"center\" colspan=\"11\" style=\"font-size: 125%\">2 x (Attk Spd 1 + Attk Spd 2)\n</td></tr></table>\n</td></tr></table>\n</td><td align=\"right\" style=\"font-size: 125%\"><br/>     <b>[2B]</b>\n</td></tr></table></i>\n</td></tr>\n<tr>\n<td><br/>Actual Critical Chance<br/><br/>\n</td><td><i>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"text-align:left;\">\n<tr>\n<td>Actual Critical Chance = \n</td><td align=\"left\"> 3%  + ( total item critical hit chance ) x 3%\n</td><td align=\"right\">       <b>[3]</b>\n</td></tr>\n</table></i>\n</td></tr>\n<tr>\n<td><br/>Avg DPS (Critical)<br/><br/>\n</td><td><i>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"text-align:left;\">\n<tr>\n<td>Avg DPS (Critical)= \n</td><td>Avg DPS x ( 1 + actual critical chance )\n</td><td align=\"right\">       <b>[4]</b>\n</td></tr></table></i>\n</td></tr>\n<tr>\n<td>Avg DPS (Critical)<br/><b>Single Weapons</b>\n</td><td><i>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"text-align:left;\">\n<tr>\n<td align=\"right\">Avg DPS (Critical)= \n</td><td>\n<table>\n<tr>\n<td><u> ( min dmg + max dmg ) </u>\n</td><td rowspan=\"2\">x ( 1 + actual critical chance )\n</td></tr>\n<tr>\n<td align=\"center\">2 x attk speed\n</td></tr></table>\n</td><td align=\"right\">       <b>[4A]</b>\n</td></tr></table></i>\n</td></tr>\n<tr>\n<td>Avg DPS (Critical)<br/><b>Dual Wield</b>\n</td><td><i>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"text-align:left;\">\n<tr>\n<td align=\"right\">Avg DPS (Critical)= \n</td><td>\n<table>\n<tr>\n<td><u> ( min dmg 1 + max dmg 1 + min dmg 2 + max dmg 2 ) </u>\n</td><td rowspan=\"2\">x ( 1 + actual critical chance )\n</td></tr>\n<tr>\n<td align=\"center\">2 x (attk spd 1 + attk spd 2)\n</td></tr></table>\n</td><td align=\"right\">       <b>[4B]</b>\n</td></tr></table></i>\n</td></tr>\n<tr>\n<td>Attack Speed<br/>with speed bonuses\n</td><td><i>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"text-align:left;\">\n<tr>\n<td align=\"right\">Attack Speed = \n</td><td>\n<table>\n<tr>\n<td style=\"font-size: 250%\" valign=\"center\">(\n</td><td>\n<table>\n<tr>\n<td align=\"center\">Base Attack Speed\n</td></tr>\n<tr>\n<td align=\"center\"><span style=\"text-decoration: overline\">( 1 + %spd bonus + %buff bonus )</span>\n</td></tr></table>\n</td><td style=\"font-size: 250%\" valign=\"center\">)\n</td></tr></table>\n</td><td align=\"right\">       <b>[5]</b>\n</td></tr></table></i><br/>\n</td></tr>\n<tr>\n<td>Avg DPS (Speed)<br/><b>Single Weapons</b><br/>Speed Bonus + Buff Bonus\n</td><td><i>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"text-align:left; font-size:80%;\">\n<tr>\n<td align=\"right\" style=\"font-size: 125%\">Avg DPS (Speed) = \n</td><td style=\"font-size: 250%\" valign=\"center\">(\n</td><td>\n<table>\n<tr>\n<td style=\"font-size: 125%\" valign=\"center\"><u>min dmg + max dmg</u>\n</td></tr>\n<tr>\n<td align=\"center\" style=\"font-size: 125%\">2 x Base Attk Spd\n</td></tr></table>\n</td><td style=\"font-size: 250%\" valign=\"center\">)\n</td><td align=\"center\" style=\"font-size: 125%\"> x\n</td><td style=\"font-size: 250%\" valign=\"center\">(\n</td><td>\n<table>\n<tr>\n<td><u>ON x ( 1 + %spd bonus + %buff bonus )</u>\n</td></tr>\n<tr>\n<td align=\"center\" style=\"font-size: 125%\">ON + OFF\n</td></tr></table>\n</td><td align=\"center\" style=\"font-size: 125%\"> +\n</td><td>\n<table>\n<tr>\n<td><u>OFF x ( 1 + %spd bonus )</u>\n</td></tr>\n<tr>\n<td align=\"center\" style=\"font-size: 125%\">ON + OFF\n</td></tr></table>\n</td><td style=\"font-size: 250%\" valign=\"center\">)\n</td><td align=\"right\" style=\"font-size: 125%\">   <b>[6A]</b>\n</td></tr></table></i>\n</td></tr>\n<tr>\n<td>Avg DPS (Speed)<br/><b>Dual Wield</b><br/>Speed Bonus + Buff Bonus\n</td><td><i>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"text-align:left; font-size:80%;\">\n<tr>\n<td align=\"right\" style=\"font-size: 125%\">Avg DPS (Speed) = \n</td><td style=\"font-size: 250%\" valign=\"center\">(\n</td><td>\n<table>\n<tr>\n<td><u>min dmg 1 + max dmg 1 + min dmg 2 + max dmg 2</u>\n</td></tr>\n<tr>\n<td align=\"center\">2 x (Base Attk Spd 1 + Base Attk Spd 2)\n</td></tr></table>\n</td><td style=\"font-size: 250%\" valign=\"center\">)\n</td><td align=\"center\" style=\"font-size: 125%\"> x\n</td><td style=\"font-size: 250%\" valign=\"center\">(\n</td><td>\n<table>\n<tr>\n<td><u>ON  x ( 1 + 20% + %spd bonus + %buff bonus )</u>\n</td></tr>\n<tr>\n<td align=\"center\" style=\"font-size: 125%\">ON + OFF\n</td></tr></table>\n</td><td align=\"center\" style=\"font-size: 125%\"> +\n</td><td>\n<table>\n<tr>\n<td><u>OFF x ( 1 + 20% + %spd bonus )</u>\n</td></tr>\n<tr>\n<td align=\"center\" style=\"font-size: 125%\">ON + OFF\n</td></tr></table>\n</td><td style=\"font-size: 250%\" valign=\"center\">)\n</td><td align=\"right\" style=\"font-size: 125%\">   <b>[6B]</b>\n</td></tr></table></i>\n</td></tr>\n<tr>\n<td>Avg DPS (Elemental)<br/>All Cases\n</td><td><i>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"text-align:left;\">\n<tr>\n<td align=\"right\">Avg DPS (Elemental) = \n</td><td> Avg DPS\n</td><td> +\n</td><td> <b>[8 <sub>Fire</sub> ]</b> + <b>[8 <sub>Ice</sub> ]</b> + <b>[8 <sub>Divine</sub> ]</b> + <b>[8 <sub>Shadow</sub> ]</b> + <b>[8 <sub>Poison</sub> ]</b>        <b>[7]</b>\n</td></tr></table></i>\n</td></tr>\n<tr>\n<td>Elemental DPS Adder\n</td><td>\n<table>\n<tr>\n<td><i>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"text-align:left;\">\n<tr>\n<td align=\"right\"><b>[8A]</b>  = \n</td><td style=\"font-size: 150%\" valign=\"center\">(\n</td><td>Element DPS Weap Attk + DPS Element Attks\n</td><td style=\"font-size: 150%\" valign=\"center\">)\n</td><td> x\n</td><td style=\"font-size: 150%\" valign=\"center\">(\n</td><td>1 + %Element\n</td><td style=\"font-size: 150%\" valign=\"center\">)\n</td></tr></table></i>\n</td></tr>\n<tr>\n<td> \n</td></tr>\n<tr>\n<td align=\"left\">Substitute appropriate Fire, Ice, Divine, Shadow or Poison for \"Element\"\n</td></tr></table>\n</td></tr>\n<tr>\n<td>Elemental DPS Adder<br/>with Buffs\n</td><td>\n<table>\n<tr>\n<td><i>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"text-align:left;\">\n<tr>\n<td align=\"right\"><b>[8B]</b>  = \n</td><td>\n<table style=\"font-size:80%;\">\n<tr>\n<td style=\"font-size: 250%\" valign=\"center\">(\n</td><td>\n<table>\n<tr>\n<td><u>30 x ( Element DPS Weap Attk + DPS Element Attks + Element Buff DPS )  +   50 x ( Element DPS Weap Attk + DPS Element Attks )</u>\n</td></tr>\n<tr>\n<td align=\"center\">80\n</td></tr></table>\n</td><td style=\"font-size: 250%\" valign=\"center\">)\n</td><td style=\"font-size: 125%\" valign=\"center\"> x ( 1 + %Element )\n</td></tr></table>\n</td></tr></table></i>\n</td></tr>\n<tr>\n<td> \n</td></tr>\n<tr>\n<td align=\"left\">Substitute appropriate Fire, Ice, Divine, Shadow or Poison for \"Element\"\n</td></tr>\n<tr>\n<td align=\"left\">Substitute approrpriate \"Element Buff DPS\" from <a href=\"/wiki/Pyromania\" title=\"Pyromania\">Pyromania</a>, <a href=\"/wiki/Chilling_Touch\" title=\"Chilling Touch\">Chilling Touch</a>, <a href=\"/wiki/Divine_Ascendancy\" title=\"Divine Ascendancy\">Divine Ascendancy</a>, <a href=\"/wiki/Dark_Wizardry\" title=\"Dark Wizardry\">Dark Wizardry</a> or <a href=\"/wiki/Toxic_Talent\" title=\"Toxic Talent\">Toxic Talent</a>\n</td></tr></table>\n</td></tr>\n</table>\n\n \n<div class=\"visualClear\"></div>"
}
