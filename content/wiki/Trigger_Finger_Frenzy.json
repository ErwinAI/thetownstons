  "html": "<table align=\"right\" cellpadding=\"2\" cellspacing=\"0\" style=\"text-align:left; background:rgb(240,240,240); border:1px solid black; width:25%;\">\n<tr>\n<td colspan=\"2\" style=\"text-align:center; background:#9999FF; font-size:150%;\"> Trigger Finger Frenzy\n</td></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align:center;\"><a class=\"image\" href=\"/images/recovered/Trigger-finger.png\" title=\"Image:Trigger-finger.jpg\"><img alt=\"Image:Trigger-finger.jpg\" border=\"0\" height=\"43\" src=\"/images/recovered/Trigger-finger.png\" width=\"43\"/></a>\n</td></tr>\n<tr>\n<td colspan=\"2\"><hr/>\n</td></tr>\n<tr>\n<td style=\"width:50%;\"><b>Skill Type: </b>\n</td><td style=\"width:50%;\">Self Buff\n</td></tr>\n<tr>\n<td style=\"width:50%;\"><b>Trainer: </b>\n</td><td style=\"width:50%;\">Ranger\n</td></tr>\n<tr>\n<td style=\"width:50%;\"><b>Number of Ranks: </b>\n</td><td style=\"width:50%;\">10\n</td></tr>\n<tr>\n<td style=\"width:50%;\"><b>Cost to Max: </b>\n</td><td style=\"width:50%;\">?\n</td></tr>\n<tr>\n<td colspan=\"2\"><hr/>\n</td></tr>\n<tr>\n<td colspan=\"2\">Increases your attack speed with two-handed ranged weapons.\n</td></tr></table>\n<p><br/>\nThis skill is a \"must-have\" for every ranged-weapon wielding ranger. It allows a ranger to unleash a devastating rapid-fire hail of projectiles at their targets, often catching opponents unawares with this devastating barrage.\n</p><p><b>Cooldown:</b> 45 Seconds\n</p><p><br/>\n</p><p><br/>\n</p><p><br/>\n</p><p><br/>\n</p><p><br/>\n</p><p><br/>\n</p><p><br/>\n</p><p><br/>\n<b>Improves Attack Speed with ranged weapons by X% for 15 seconds.</b>\n</p>\n<table align=\"left\" border=\"1\" cellpadding=\"2\" cellspacing=\"0\" style=\"text-align:center; width:100%; background:rgb(240,240,240);\">\n<tr>\n<td style=\"background:#9999FF\" width=\"10%\">Skill Level\n</td><td style=\"background:#9999FF\">1\n</td><td style=\"background:#9999FF\">2\n</td><td style=\"background:#9999FF\">3\n</td><td style=\"background:#9999FF\">4\n</td><td style=\"background:#9999FF\">5\n</td><td style=\"background:#9999FF\">6\n</td><td style=\"background:#9999FF\">7\n</td><td style=\"background:#9999FF\">8\n</td><td style=\"background:#9999FF\">9\n</td><td style=\"background:#9999FF\">10\n</td></tr>\n<tr>\n<td style=\"background:#9999FF\" width=\"10%\">Req Char Lvl\n</td><td> 5\n</td><td> 15\n</td><td> 25\n</td><td> 35\n</td><td> 45\n</td><td> 55\n</td><td> 65\n</td><td> 75\n</td><td> 85\n</td><td> 95\n</td></tr>\n<tr>\n<td style=\"background:#9999FF\" width=\"10%\">Mana Cost\n</td><td> 32.1\n</td><td> 56.4\n</td><td> 80.7\n</td><td> 105\n</td><td> 129.3\n</td><td> 153.6\n</td><td> 177.9\n</td><td> 202.2\n</td><td> 226.5\n</td><td> 250.8\n</td></tr>\n<tr>\n<td style=\"background:#9999FF\" width=\"10%\">X\n</td><td> 30\n</td><td> 40\n</td><td> 50\n</td><td> 60\n</td><td> 70\n</td><td> 80\n</td><td> 90\n</td><td> 100\n</td><td> 110\n</td><td> 110\n</td></tr>\n<tr>\n<td style=\"background:#9999FF\" width=\"10%\">Upgrade Cost\n</td><td> 9744\n</td><td> 29232\n</td><td> 48720\n</td><td> 68209\n</td><td> 87697\n</td><td> 107185\n</td><td> 126674\n</td><td> 146162\n</td><td> 165650\n</td><td> 185139\n</td></tr>\n</table>\n<p> <br/>\n <br/>\n</p>\n\n \n<div class=\"visualClear\"></div>"
