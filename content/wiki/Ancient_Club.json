  "html": "<table align=\"right\" cellpadding=\"2\" cellspacing=\"0\" style=\"text-align:left; background:rgb(240,240,240); border:1px solid black; width:25%;\">\n<tr>\n<td colspan=\"2\" style=\"text-align:center; background:#9999FF; font-size:150%;\"> Ancient Club\n</td></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align:center;\"><a class=\"image\" href=\"/images/recovered/1h-weapon-_Ancient_Club_.png\" title=\"Ancient Club\"><img alt=\"Ancient Club\" border=\"0\" src=\"/images/recovered/1h-weapon-_Ancient_Club_.png\"/></a>\n</td></tr>\n<tr>\n<td colspan=\"2\"><hr/>\n</td></tr>\n<tr>\n<td style=\"width:50%;\"><b>Damage Type:&nbsp;</b>\n</td><td style=\"width:50%;\">Crushing\n</td></tr>\n<tr>\n<td style=\"width:50%;\"><b>Wielding:&nbsp;</b>\n</td><td style=\"width:50%;\">One-Handed\n</td></tr>\n<tr>\n<td style=\"width:50%;\"><b>Attack Speed:&nbsp;</b>\n</td><td style=\"width:50%;\">Normal\n</td></tr>\n<tr>\n<td style=\"width:50%;\"><b>Client weapon speed:&nbsp;</b>\n</td><td style=\"width:50%;\">100\n</td></tr>\n<tr>\n<td style=\"width:50%;\"><b>Client damage coeff:&nbsp;</b>\n</td><td style=\"width:50%;\">0.83\n</td></tr>\n</table>\n<p><b>Ancient Club</b> is listed on the <a href=\"/wiki/Category/One-Handed-fighter\" title=\"Category:One-Handed-fighter\">One-Handed-fighter</a> weapon list. Stats on this page come from that list and the Dungeon Runners client files.</p>\n<p>The client also has material-tier versions of this weapon (Cardboard Ancient Club, Celestial Ancient Club, Default Ancient Club, Diamond Ancient Club, Iron Ancient Club, Obsidian Ancient Club, Stone Ancient Club, Tin Ancient Club, \u2026).</p>\n<div class=\"visualClear\"></div>"
